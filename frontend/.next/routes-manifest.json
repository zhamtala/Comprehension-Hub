    {
      "page": "/dashboards/StudentDashboard",
      "regex": "^/dashboards/StudentDashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboards/StudentDashboard(?:/)?$"
    },
    {
      "page": "/dictionary",
      "regex": "^/dictionary(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dictionary(?:/)?$"
    },
    {
      "page": "/download",
      "regex": "^/download(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/download(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/grammar",
      "regex": "^/grammar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/grammar(?:/)?$"
    },
    {
      "page": "/listening",
      "regex": "^/listening(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/listening(?:/)?$"
